# Copier en .env (jamais commité) et compléter avec de vraies valeurs.

# Clé API du serveur MCP Stitch (https://stitch.withgoogle.com) — utilisée par .mcp.json
# (référencée via ${STITCH_API_KEY}, jamais écrite en clair dans un fichier commité).
STITCH_API_KEY=changeme

# Token GitHub (PAT) du serveur MCP GitHub (api.githubcopilot.com/mcp) — utilisé par .mcp.json
# (référencé via ${GITHUB_MCP_TOKEN}, en-tête Authorization: Bearer). Scope requis : `repo`
# (accès aux dépôts privés). Sans ce scope l'authentification réussit mais les dépôts privés
# renvoient 404. Jamais écrit en clair dans un fichier commité.
GITHUB_MCP_TOKEN=changeme
