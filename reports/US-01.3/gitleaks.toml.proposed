title = "Concentration — configuration gitleaks (US-00.1)"

# Hérite de TOUTES les règles gitleaks par défaut (large filet de sécurité).
# On ne fait qu'AJOUTER des règles/allowlists ciblées — jamais repartir d'une config vide.
[extend]
useDefault = true

# ───────────────────────────────────────────────────────────────────────────────
#  Règles ciblées (en plus du filet par défaut). Chaque règle porte sa justification.
# ───────────────────────────────────────────────────────────────────────────────

# Clé API Google/Stitch (format AIza…). Le serveur MCP Stitch consomme une clé Google
# via l'en-tête X-Goog-Api-Key. Règle explicite (double la règle par défaut, robustesse).
[[rules]]
id = "google-api-key-stitch"
description = "Cle API Google/Stitch (AIza...) — ne jamais committer en clair"
regex = '''AIza[0-9A-Za-z\-_]{35}'''
keywords = ["aiza"]

# Jeton Stitch éventuel au format AQ.<token>. Regex bornée (>= 20 caractères après
# 'AQ.') pour éviter les faux positifs sur un 'AQ.' isolé.
# ⚠️ À CALIBRER par l'humain qui détient la vraie clé, SANS jamais coller la clé ici.
[[rules]]
id = "stitch-token-aq"
description = "Jeton Stitch AQ.<token> — ne jamais committer en clair"
regex = '''AQ\.[A-Za-z0-9_\-]{20,}'''
keywords = ["aq."]

# ───────────────────────────────────────────────────────────────────────────────
#  Signature mobile (US-01.3, T4 — AC-4 Erreur, risque R-4). Proposé par @Developer
#  le 2026-10-02, APPLIQUÉ PAR L'HUMAIN (Art. 6). Constat de départ (C-11, mesuré) :
#  avec les seules règles ci-dessus, un keystore binaire et un mot de passe de faible
#  entropie dans un fichier de propriétés rendaient « no leaks found ».
#  Critère exécutable : python reports/US-01.3/gitleaks_t4_criterion.py
#  ⚠️ Deux couches distinctes : ces règles lisent le CONTENU (et le chemin) ; le refus
#  de TOUT fichier de propriétés de signature SUIVI, même sans mot de passe, est porté
#  par T2 (scripts/deploiement/check_secrets_signature.py), par son NOM. Elles ne le
#  remplacent pas, et T2 ne les remplace pas.
# ───────────────────────────────────────────────────────────────────────────────

# Règle de CHEMIN : un fichier dont l'extension est celle d'un keystore est un constat,
# quel que soit son contenu (aucune regex : gitleaks signale le fichier lui-même).
# ⚠️ BORNE MESURÉE (2026-10-02, gitleaks 8.30.1) : en mode « git » (celui de la CI et
# du hook pre-commit), un fichier BINAIRE n'a aucune ligne ajoutée dans le diff que lit
# gitleaks ⇒ cette règle ne le voit PAS. Elle le voit en mode « dir », et en mode « git »
# pour un fichier au contenu texte. En CI, le keystore binaire est vu par T2
# (reconnaissance par le contenu). Extensions non listées (.bks, .jceks, .bcfks…) : T2 seul.
[[rules]]
id = "signature-keystore-chemin"
description = "Fichier de keystore (.jks, .keystore, .p12, .pfx) — ne jamais le versionner"
path = '''(?i)\.(?:jks|keystore|p12|pfx)$'''

# Règle de MOT-CLÉ, fichier de propriétés : la valeur d'un mot de passe de signature,
# QUELLE QUE SOIT SON ENTROPIE (un mot de passe humain faible est un secret). Aucune
# entropie minimale, délibérément.
# Ne déclenche pas : valeur vide, valeur réservée commençant par « < » (<à renseigner>)
# ou par « $ » ($VAR, ${VAR}), clé citée dans une expression (props["storePassword"]),
# fichier de propriétés sans mot de passe.
# ⚠️ BORNE MESURÉE : l'allowlist globale ci-dessous (« changeme ») s'applique aussi à
# cette règle ⇒ un mot de passe CONTENANT « changeme » n'est pas signalé.
[[rules]]
id = "signature-mot-de-passe-proprietes"
description = "Mot de passe de signature dans un fichier de proprietes — ne jamais le versionner"
path = '''(?i)\.properties$'''
regex = '''(?im)^[ \t]*(?:store|key)Password(?:[ \t]*[=:][ \t]*|[ \t]+)([^\s"'<$\[\]{}()=:][^\r\n]*)'''
secretGroup = 1
keywords = ["storepassword", "keypassword"]

# Règle de MOT-CLÉ, script de build Gradle (.gradle, .gradle.kts) : un LITTÉRAL cité
# affecté à storePassword / keyPassword, quelle que soit son entropie.
# Ne déclenche pas : expression (keystoreProperties["storePassword"] as String,
# System.getenv(...)), littéral contenant « $ » (interpolation), littéral réservé
# commençant par « < ».
[[rules]]
id = "signature-mot-de-passe-script"
description = "Mot de passe de signature en dur dans un script de build Gradle — ne jamais le versionner"
path = '''(?i)\.gradle(?:\.kts)?$'''
regex = '''(?i)\b(?:store|key)Password[ \t]*(?:=|[ \t])[ \t]*["']([^"'\r\n$<][^"'\r\n$]*)["']'''
secretGroup = 1
keywords = ["storepassword", "keypassword"]

# ───────────────────────────────────────────────────────────────────────────────
#  Allowlist chirurgicale — chaque entrée vise un placeholder PROUVÉ ou un fichier
#  légitime, avec justification. Jamais de désactivation globale d'une règle.
# ───────────────────────────────────────────────────────────────────────────────
[allowlist]
description = "Placeholders prouves et fichiers de config legitimes du depot"

regexes = [
  '''changeme''',              # placeholder des gabarits .env.example (valeur factice prouvée)
  '''\$\{[A-Z_]+\}''',         # interpolation d'environnement (${STITCH_API_KEY}) — pas un secret
]

paths = [
  '''\.env\.example$''',                  # gabarit de secrets : placeholders uniquement
  '''\.mcp\.json$''',                      # config MCP : ${STITCH_API_KEY} interpolé, pas de secret en clair
  '''\.env$''',                            # secrets locaux, gitignorés — jamais committés
  '''\.claude/settings\.local\.json$''',   # config locale (peut contenir STITCH_API_KEY), gitignorée
  '''reports/US-00\.1/gitleaks\.toml\.proposed$''',  # CE fichier de proposition (contient des regexes, pas des secrets)
]

# ───────────────────────────────────────────────────────────────────────────────
#  NOTE d'ingénierie (@Developer) — artefacts de signature mobile
#  Les keystores Android (.jks/.keystore) et certificats iOS (.p12/.mobileprovision)
#  sont des binaires porteurs de secrets : gitleaks détecte des secrets DANS le texte,
#  il ne « bloque » pas un binaire par son extension. La bonne barrière est le
#  .gitignore (ne jamais suivre ces fichiers) + secret de plateforme en CI.
#  → À arbitrer avec @DevOps quand la signature mobile arrivera (hors périmètre du MVP,
#    RNF-07 offline-first : aucun secret runtime aujourd'hui). Volontairement PAS de
#    règle gitleaks factice ici (elle serait non fonctionnelle).
#
#  ⛔ PÉRIMÉ-2026-10-02 (US-01.3, T4) — la NOTE ci-dessus n'est pas repeinte. Ce qui en
#  reste VRAI, et MESURÉ : en mode « git » (CI, pre-commit), une règle de chemin ne voit
#  pas un keystore BINAIRE. Ce qui est devenu FAUX : « hors périmètre », « aucune règle »
#  et « elle serait non fonctionnelle » sans nuance — la signature mobile est arrivée
#  (US-01.3) ; la règle de chemin est fonctionnelle en mode « dir », les deux règles de
#  mot-clé en mode « dir » ET « git ». Le .gitignore racine et le contrôle T2 restent les
#  barrières du keystore binaire en CI.
# ───────────────────────────────────────────────────────────────────────────────
